      <column caption='Artist Type' datatype='string' name='[Calculation_1502326421024768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [artist_count] = 1 THEN&#10;    &quot;Solo&quot;&#10;ELSE&#10;    &quot;Collaboration&quot;&#10;END' />
